#!/bin/sh
# pre-commit: block commits that break the tests or leak personal data. Enable once per clone:
#   git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
DEFAULT_PATTERN='[A-Za-z0-9._%+-]+@(gmail|outlook|live|hotmail|yahoo|icloud)\.[a-z]+'
PATTERN="${CAPY_PII_PATTERN:-$DEFAULT_PATTERN}"
if git diff --cached -U0 --diff-filter=AM -- . ':!.githooks' | grep '^+' | grep -Eiq "$PATTERN"; then
  echo "pre-commit: staged lines look like personal data (email address). Override once with: git commit --no-verify" >&2
  exit 1
fi
scripts/test.sh || { echo "pre-commit: tests failed; commit aborted." >&2; exit 1; }
